{
  "name": "novelforge",
  "version": "1.0.0",
  "type": "module",
  "description": "AI assisted long-form novel writing library and CLI tool",
  "main": "lib/index.js",
  "bin": {
    "novel": "bin/novel.js"
  },
  "exports": {
    ".": "lib/index.js",
    "./agents": "lib/agents/agent.js",
    "./kg": "lib/kg/kg-files.js",
    "./llm": "lib/llm/llm.js",
    "./utils": "lib/utils/parser.js",
    "./cli": "lib/cli/index.js"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/novel.js",
    "test": "node --test",
    "prepublishOnly": "npm run test"
  },
  "keywords": [
    "novel",
    "ai",
    "writing",
    "agent",
    "knowledge-graph",
    "cli",
    "library"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "inquirer": "^10.0.0",
    "openai": "^6.34.0"
  }
}
