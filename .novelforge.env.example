# MiniMax M2-her配置（默认模型）
LLM_PROVIDER=custom
LLM_BASE_URL=https://api.minimax.chat/v1
LLM_API_KEY=sk-cp-fFz5mi567KuMh0MTcqGIsI4mvk3ESOX2INO8qdlCAAlMbz2l4OZj18qe0eul7iiz3ur3kZpTlUl8p59q1EqMGlHjuPCFtUonTFuJrS1SvVHzAaM0iN4cYkk
LLM_MODEL=MiniMax-M2-her
LLM_MODEL_DEFAULT=true
LLM_USE_CHAT=openAi

# 说明：
# LLM_MODEL: 主要模型配置
# LLM_MODEL_DEFAULT=true: 使用LLM_MODEL作为默认模型
# LLM_USE_CHAT=openAi: 强制使用OpenAI API调用方式
# LLM_USE_CHAT=minimax: 使用MiniMax API调用方式
# 支持多模型配置，根据LLM_MODEL_DEFAULT和LLM_USE_CHAT来决定调用方式